# ============================================================================
# Living Finds — Backend self-hosted (.env)
# Copie para .env e preencha. NUNCA versione o .env real.
# ============================================================================

# --- Infra ---
DATABASE_URL=postgres://livingfinds:CHANGE_ME@db:5432/livingfinds
DB_PASSWORD=CHANGE_ME
PORT=8000
APP_BASE_URL=http://localhost:8000
RELEASE_ID=development
# Token exigido nas chamadas externas a /functions/* (header Authorization: Bearer <token>).
# Deixe vazio em dev para liberar. Gere um forte em produção.
API_TOKEN=
ADMIN_PASSWORD=
# Liga/desliga o agendador de crons (janela noturna etc.)
ENABLE_SCHEDULER=true
# Usuário-padrão (single-tenant)
DEFAULT_USER_ID=system
DEFAULT_USER_EMAIL=daniel@livingfinds.local
DEFAULT_USER_NAME=Living Finds

# --- Amazon Advertising API (Ads) ---
ADS_CLIENT_ID=
ADS_CLIENT_SECRET=
ADS_REFRESH_TOKEN=
ADS_PROFILE_ID=
ADS_ACCOUNT_ID=
ADS_REGION=NA            # NA | EU | FE

# --- Amazon Selling Partner API (SP-API) ---
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_REFRESH_TOKEN=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=
AMAZON_SELLER_ID=
AMAZON_SP_APP_ID=

# --- IA (Anthropic / Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-3-5-sonnet-20241022
AI_WEEKLY_REVIEW_MODEL=claude-opus-4-1

# --- Busca / externos ---
SERPER_API_KEY=
XANO_API_KEY=
XANO_BASE_URL=

# --- Google Drive (backups — opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# --- Discord (notificações noturnas) ---
DISCORD_WEBHOOK_URL=

# --- Caminhos (opcional — default aponta para ../base44) ---
# FUNCTIONS_DIR=/app/base44/functions
# SCHEDULES_FILE=/app/base44/schedules/amazon-automation-schedule.json
# ENTITIES_DIR=/app/base44/entities
