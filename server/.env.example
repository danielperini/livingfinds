# ============================================================================
# Living Finds — Backend self-hosted (.env)
# Copie para .env e preencha. NUNCA versione o .env real.
# ============================================================================

# --- Infra ---
DATABASE_URL=postgres://livingfinds:CHANGE_ME@db:5432/livingfinds
PORT=8000
# Em produção: URL pública EXATA do app. O OAuth Ads usa
# ${APP_BASE_URL}/amazon-ads-callback como redirect_uri e não possui hardcode.
APP_BASE_URL=http://localhost:8000
# Token exigido nas chamadas externas a /functions/*.
API_TOKEN=
ENABLE_SCHEDULER=true
LIVINGFINDS_AUTOMATIC_REPRICING_V2_ENABLED=false
DEFAULT_USER_ID=system
DEFAULT_USER_EMAIL=daniel@livingfinds.local
DEFAULT_USER_NAME=Living Finds

# --- Amazon Advertising API (Ads) — nomes CANÔNICOS ---
# Para Ads, use ADS_*; não reutilize o app LWA da SP-API por conveniência.
ADS_CLIENT_ID=
ADS_CLIENT_SECRET=
# Após uma reautorização OAuth, o banco vira fonte primária em runtime.
# Mantenha este secret sincronizado na VPS para restart/deploy/fallback quando DB estiver sem token.
ADS_REFRESH_TOKEN=
ADS_PROFILE_ID=
ADS_ACCOUNT_ID=
# Brasil pertence à região Ads NA e usa advertising-api.amazon.com.
ADS_REGION=NA            # NA | EU | FE

# --- Amazon Selling Partner API (SP-API) — nomes CANÔNICOS ---
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=
AMAZON_SELLER_ID=
AMAZON_SP_APP_ID=

# Aliases legados SP_* — somente fallback de compatibilidade.
# Não os preencha quando os AMAZON_* canônicos já estiverem configurados.
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_REFRESH_TOKEN=

# --- IA (Anthropic / Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-3-5-sonnet-20241022
AI_WEEKLY_REVIEW_MODEL=claude-opus-4-1

# --- Busca / externos ---
SERPER_API_KEY=
ZYTE_API_KEY=
ZYTE_DAILY_REQUEST_LIMIT=200
ZYTE_MAX_ATTEMPTS=3
ZYTE_REQUEST_TIMEOUT_MS=45000
XANO_API_KEY=
XANO_BASE_URL=

# --- Google Drive (backups — opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# --- Discord (notificações noturnas) ---
DISCORD_WEBHOOK_URL=

# --- Caminhos (opcional — default aponta para ../base44) ---
# FUNCTIONS_DIR=/app/base44/functions
# SCHEDULES_FILE=/app/base44/schedules/amazon-automation-schedule.json
# ENTITIES_DIR=/app/base44/entities
