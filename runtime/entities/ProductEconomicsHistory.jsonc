{
  "name": "ProductEconomicsHistory",
  "type": "object",
  "properties": {
    "amazon_account_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "asin": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "normalized_sku": {
      "type": "string"
    },
    "unit_cost_before": {
      "type": "number",
      "default": 0
    },
    "unit_cost_after": {
      "type": "number",
      "default": 0
    },
    "additional_cost_before": {
      "type": "number",
      "default": 0
    },
    "additional_cost_after": {
      "type": "number",
      "default": 0
    },
    "price_before": {
      "type": "number",
      "default": 0
    },
    "price_after": {
      "type": "number",
      "default": 0
    },
    "fee_before": {
      "type": "number",
      "default": 0
    },
    "fee_after": {
      "type": "number",
      "default": 0
    },
    "margin_before": {
      "type": "number",
      "default": 0
    },
    "margin_after": {
      "type": "number",
      "default": 0
    },
    "break_even_before": {
      "type": "number",
      "default": 0
    },
    "break_even_after": {
      "type": "number",
      "default": 0
    },
    "source": {
      "type": "string"
    },
    "history_type": {
      "type": "string",
      "enum": [
        "cost_change",
        "economic_evaluation",
        "price_recommendation",
        "price_submission",
        "price_confirmed",
        "price_failed"
      ]
    },
    "action_queue_id": {
      "type": "string"
    },
    "minimum_profitable_price": {
      "type": "number"
    },
    "target_margin_price": {
      "type": "number"
    },
    "unit_profit_before": {
      "type": "number"
    },
    "unit_profit_after": {
      "type": "number"
    },
    "expected_daily_profit": {
      "type": "number"
    },
    "sales_before": {
      "type": "number"
    },
    "sales_after": {
      "type": "number"
    },
    "units_before": {
      "type": "number"
    },
    "units_after": {
      "type": "number"
    },
    "conversion_before": {
      "type": "number"
    },
    "conversion_after": {
      "type": "number"
    },
    "ads_cost_before": {
      "type": "number"
    },
    "ads_cost_after": {
      "type": "number"
    },
    "stock_before": {
      "type": "number"
    },
    "stock_after": {
      "type": "number"
    },
    "featured_offer_before": {
      "type": "number"
    },
    "featured_offer_after": {
      "type": "number"
    },
    "decision_reason": {
      "type": "string"
    },
    "decision_evidence": {
      "type": "object"
    },
    "amazon_response": {
      "type": "object"
    },
    "status": {
      "type": "string"
    },
    "next_evaluation_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string"
    },
    "import_batch_id": {
      "type": "string"
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "changed_by": {
      "type": "string"
    },
    "changed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "amazon_account_id",
    "sku",
    "changed_at"
  ]
}
