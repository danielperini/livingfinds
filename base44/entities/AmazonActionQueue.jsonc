{
  "name": "AmazonActionQueue",
  "type": "object",
  "properties": {
    "amazon_account_id": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "campaign",
        "ad_group",
        "keyword",
        "product_ad",
        "target",
        "budget",
        "bid",
        "negative",
        "product_price"
      ]
    },
    "entity_id": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "keyword_id": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "sku": {
      "type": "string"
    },
    "normalized_sku": {
      "type": "string"
    },
    "asin": {
      "type": "string"
    },
    "marketplace_id": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "old_price": {
      "type": "number"
    },
    "new_price": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "expected_margin": {
      "type": "number"
    },
    "expected_unit_profit": {
      "type": "number"
    },
    "expected_daily_profit": {
      "type": "number"
    },
    "next_retry_at": {
      "type": "string",
      "format": "date-time"
    },
    "amazon_request": {
      "type": "object"
    },
    "amazon_response": {
      "type": "object"
    },
    "submission_id": {
      "type": "string"
    },
    "history_id": {
      "type": "string"
    },
    "confirmed_price": {
      "type": "number"
    },
    "confirmation_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "normal",
        "low",
        "background"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "running",
        "submitted",
        "processing",
        "confirmed",
        "blocked",
        "completed",
        "failed",
        "skipped",
        "cancelled"
      ],
      "default": "pending"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "attempt_count": {
      "type": "number",
      "default": 0
    },
    "max_attempts": {
      "type": "number",
      "default": 3
    },
    "last_error": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "requires_ai": {
      "type": "boolean",
      "default": false
    },
    "ai_completed": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "amazon_account_id",
    "operation",
    "entity_type",
    "idempotency_key"
  ]
}
