{
  "name": "Product",
  "type": "object",
  "properties": {
    "amazon_account_id": {
      "type": "string"
    },
    "asin": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "product_image_url": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "archived"
      ],
      "default": "active"
    },
    "inventory_status": {
      "type": "string",
      "enum": [
        "in_stock",
        "out_of_stock",
        "low_stock"
      ],
      "default": "in_stock"
    },
    "previous_inventory_status": {
      "type": "string"
    },
    "previous_fba_inventory": {
      "type": "number",
      "default": 0
    },
    "fba_inventory": {
      "type": "number",
      "default": 0
    },
    "reserved_inventory": {
      "type": "number",
      "default": 0
    },
    "inbound_inventory": {
      "type": "number",
      "default": 0
    },
    "available_quantity": {
      "type": "number",
      "default": 0
    },
    "total_quantity": {
      "type": "number",
      "default": 0
    },
    "price": {
      "type": "number"
    },
    "price_source": { "type": "string", "description": "Origem canônica do preço atual exibido." },
    "listing_status": {
      "type": "string",
      "enum": ["active", "inactive", "not_found", "error", "unknown"],
      "default": "unknown"
    },
    "listing_buyable": { "type": "boolean", "default": false },
    "listing_checked_at": { "type": "string", "format": "date-time" },
    "listing_issues_count": { "type": "number", "default": 0 },
    "first_available_date": {
      "type": "string",
      "format": "date"
    },
    "is_new_asin": {
      "type": "boolean",
      "default": false
    },
    "has_campaign": {
      "type": "boolean",
      "default": false
    },
    "campaign_status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "incomplete",
        "historical",
        "none"
      ],
      "default": "none"
    },
    "campaign_pause_lock": {
      "type": "boolean",
      "default": false,
      "description": "Trava persistente: impede qualquer reativação automática enquanto o produto permanecer pausado."
    },
    "campaign_pause_lock_reason": {
      "type": "string"
    },
    "campaign_pause_locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "campaign_pause_locked_by": {
      "type": "string"
    },
    "should_activate_campaign": {
      "type": "boolean",
      "default": false
    },
    "linked_campaign_id": {
      "type": "string"
    },
    "linked_campaign_name": {
      "type": "string"
    },
    "linked_campaign_count": {
      "type": "number",
      "default": 0
    },
    "linked_campaign_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "campaign_link_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "auto_campaign_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "manual_campaign_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "days_since_launch": {
      "type": "number",
      "default": 0
    },
    "total_spend_30d": {
      "type": "number",
      "default": 0
    },
    "total_sales_30d": {
      "type": "number",
      "default": 0
    },
    "total_units_30d": {
      "type": "number",
      "default": 0
    },
    "daily_sales_velocity_30d": {
      "type": "number",
      "default": 0,
      "description": "Velocidade diária de unidades calculada com vendas reais da SP-API."
    },
    "days_of_supply": {
      "type": "number",
      "description": "Dias de cobertura usando somente estoque vendável disponível agora."
    },
    "days_of_supply_with_inbound": {
      "type": "number",
      "description": "Cobertura projetada incluindo inbound; não remove a proteção do estoque atual."
    },
    "inventory_coverage_status": {
      "type": "string",
      "enum": [
        "out_of_stock",
        "insufficient_history",
        "no_velocity",
        "critical",
        "low",
        "healthy"
      ]
    },
    "inventory_signal_quality": {
      "type": "string",
      "enum": [
        "sufficient",
        "insufficient_history"
      ]
    },
    "inventory_signal_observed_days": {
      "type": "number",
      "default": 0
    },
    "inventory_signal_calculated_at": {
      "type": "string",
      "format": "date-time"
    },
    "acos": {
      "type": "number",
      "default": 0
    },
    "roas": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string"
    },
    "catalog_sync_status": {
      "type": "string",
      "enum": [
        "pending",
        "syncing",
        "success",
        "not_found",
        "error"
      ],
      "default": "pending"
    },
    "catalog_sync_error": {
      "type": "string"
    },
    "catalog_sync_attempts": {
      "type": "number",
      "default": 0
    },
    "last_catalog_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "product_cost": {
      "type": "number"
    },
    "extra_cost": {
      "type": "number",
      "default": 0
    },
    "cost_confirmed": {
      "type": "boolean",
      "default": false
    },
    "cost_confirmation_required": {
      "type": "boolean",
      "default": true
    },
    "cost_source": {
      "type": "string",
      "enum": [
        "historical_import",
        "manual",
        "unknown"
      ],
      "default": "unknown"
    },
    "cost_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "cost_confirmed_by": {
      "type": "string"
    },
    "maximum_ad_spend_per_order": {
      "type": "number",
      "default": 0
    },
    "break_even_acos_pct": {
      "type": "number",
      "default": 0
    },
    "available_profit_per_sale": {
      "type": "number",
      "default": 0
    },
    "auto_campaign_eligible": {
      "type": "boolean",
      "default": false
    },
    "keyword_confidence_threshold": {
      "type": "number",
      "default": 0.95
    },
    "cost_dialog_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "amazon_fees": {
      "type": "number"
    },
    "contribution_margin": {
      "type": "number"
    },
    "profit_margin_pct": {
      "type": "number"
    },
    "buy_box_status": {
      "type": "string",
      "enum": [
        "owned",
        "shared",
        "lost",
        "unknown"
      ],
      "default": "unknown"
    },
    "buy_box_price": {
      "type": "number"
    },
    "stock_days": {
      "type": "number"
    },
    "minimum_stock": {
      "type": "number",
      "default": 5
    },
    "organic_sales_30d": {
      "type": "number",
      "default": 0
    },
    "ad_sales_30d": {
      "type": "number",
      "default": 0
    },
    "tacos": {
      "type": "number",
      "default": 0
    },
    "profit_after_ads": {
      "type": "number"
    },
    "sessions_30d": {
      "type": "number",
      "default": 0
    },
    "conversion_rate_30d": {
      "type": "number",
      "default": 0
    },
    "ads_scope_status": {
      "type": "string",
      "enum": [
        "authorized",
        "not_authorized",
        "temporarily_ineligible",
        "manual_block",
        "mapping_conflict"
      ],
      "default": "not_authorized",
      "description": "Status de autoriza\u00e7\u00e3o do SKU para participar do fluxo de publicidade"
    },
    "ads_authorized_by_user": {
      "type": "boolean",
      "default": false
    },
    "ads_authorized_at": {
      "type": "string",
      "format": "date-time"
    },
    "ads_authorized_by": {
      "type": "string"
    },
    "ads_eligibility_status": {
      "type": "string",
      "enum": [
        "eligible",
        "out_of_stock",
        "low_stock",
        "listing_suppressed",
        "listing_inactive",
        "offer_inactive",
        "not_buyable",
        "mapping_conflict",
        "not_authorized",
        "manual_block",
        "data_stale",
        "unknown"
      ],
      "default": "unknown"
    },
    "ads_ineligibility_reason": {
      "type": "string"
    },
    "ads_last_eligibility_check_at": {
      "type": "string",
      "format": "date-time"
    },
    "ads_resume_pending": {
      "type": "boolean",
      "default": false
    },
    "ads_previous_campaign_state": {
      "type": "string"
    },
    "ads_pause_reason": {
      "type": "string"
    },
    "ads_paused_at": {
      "type": "string",
      "format": "date-time"
    },
    "ads_mapping_conflict_asin": {
      "type": "string"
    },
    "ads_mapping_conflict_sku": {
      "type": "string"
    },
    "ads_scope_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "ads_scope_updated_by": {
      "type": "string"
    },
    "listing_buyable": {
      "type": "boolean",
      "default": true
    },
    "offer_active": {
      "type": "boolean",
      "default": true
    },
    "listing_suppressed": {
      "type": "boolean",
      "default": false
    },
    "listing_status_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Indica que summary.status foi realmente observado na Listings Items API; resposta sem status não invalida o último estado confirmado."
    },
    "market_price_average": {
      "type": "number",
      "description": "Pre\u00e7o m\u00e9dio das ofertas p\u00fablicas do ASIN no marketplace (n\u00e3o \u00e9 price/buy_box_price)"
    },
    "market_price_minimum": {
      "type": "number",
      "description": "Pre\u00e7o m\u00ednimo observado entre as ofertas v\u00e1lidas"
    },
    "market_price_maximum": {
      "type": "number",
      "description": "Pre\u00e7o m\u00e1ximo observado entre as ofertas v\u00e1lidas"
    },
    "market_price_median": {
      "type": "number",
      "description": "Mediana dos pre\u00e7os das ofertas v\u00e1lidas"
    },
    "market_price_offer_count": {
      "type": "number",
      "description": "Quantidade de ofertas v\u00e1lidas usadas no c\u00e1lculo"
    },
    "market_price_currency": {
      "type": "string",
      "description": "Moeda das ofertas (ex: BRL)"
    },
    "market_price_source": {
      "type": "string",
      "description": "Provedor que retornou os dados: zinc ou scrapingbee"
    },
    "market_price_provider": {
      "type": "string",
      "description": "Nome leg\u00edvel do provedor"
    },
    "market_price_marketplace": {
      "type": "string",
      "description": "Marketplace consultado (ex: BR)"
    },
    "market_price_status": {
      "type": "string",
      "enum": [
        "not_checked",
        "queued",
        "processing",
        "success",
        "no_offers",
        "unsupported_marketplace",
        "rate_limited",
        "credit_limit_reached",
        "failed"
      ],
      "default": "not_checked",
      "description": "Status da \u00faltima consulta de pre\u00e7o de mercado"
    },
    "market_price_last_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando foi feita a \u00faltima consulta bem-sucedida"
    },
    "market_price_next_check_at": {
      "type": "string",
      "format": "date-time",
      "description": "Agendamento da pr\u00f3xima consulta (para retry)"
    },
    "market_price_error": {
      "type": "string",
      "description": "Mensagem de erro sanitizada da \u00faltima tentativa (sem secrets)"
    },
    "market_price_excluded_offer_count": {
      "type": "number",
      "description": "Quantidade de ofertas exclu\u00eddas por serem outliers"
    },
    "market_price_basis": {
      "type": "string",
      "description": "Como o pre\u00e7o foi calculado: ITEM_ONLY ou ITEM_PLUS_REQUIRED_SHIPPING"
    },
    "market_price_request_id": {
      "type": "string",
      "description": "Request ID retornado pelo provedor para rastreio"
    },
    "market_price_updated_by": {
      "type": "string",
      "description": "Usu\u00e1rio ou fun\u00e7\u00e3o que disparou a \u00faltima atualiza\u00e7\u00e3o"
    },
    "decision_journey_state": {
      "type": "string",
      "enum": ["NOT_ELIGIBLE", "ECONOMICS_PENDING", "READY_FOR_DISCOVERY", "DISCOVERY_AUTO", "LEARNING", "HARVEST_PENDING", "MANUAL_CREATION_PENDING", "MANUAL_VALIDATION", "ACTIVE_OPTIMIZATION", "LOW_VOLUME_GUARDED", "PROTECTED_WINNER", "OUT_OF_STOCK", "COOLDOWN", "ARCHIVED", "ERROR_RETRYABLE", "ERROR_BLOCKED"]
    },
    "decision_journey_reason": { "type": "string" },
    "decision_journey_snapshot_id": { "type": "string" },
    "decision_journey_updated_at": { "type": "string", "format": "date-time" },
    "decision_journey_next_evaluation_at": { "type": "string", "format": "date-time" },
    "decision_journey_transition": { "type": "object" }
  },
  "required": [
    "amazon_account_id",
    "asin"
  ]
}
