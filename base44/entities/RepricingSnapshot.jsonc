{
  "name": "RepricingSnapshot",
  "type": "object",
  "properties": {
    "amazon_account_id": { "type": "string" },
    "marketplace_id": { "type": "string" },
    "seller_id": { "type": "string" },
    "product_id": { "type": "string" },
    "sku": { "type": "string" },
    "asin": { "type": "string" },
    "snapshot_key": { "type": "string" },
    "profile_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "run_id": { "type": "string" },
    "decision_window": { "type": "string" },
    "window_start": { "type": "string", "format": "date-time" },
    "window_end": { "type": "string", "format": "date-time" },
    "captured_at": { "type": "string", "format": "date-time" },
    "data_freshness_status": { "type": "string" },
    "ads_data_fresh_at": { "type": "string", "format": "date-time" },
    "sp_api_data_fresh_at": { "type": "string", "format": "date-time" },
    "economics_data_fresh_at": { "type": "string", "format": "date-time" },
    "listing_status": { "type": "string" },
    "offer_status": { "type": "string" },
    "buyable": { "type": "boolean" },
    "buy_box_status": { "type": "string" },
    "inventory_available": { "type": "number" },
    "inventory_inbound": { "type": "number" },
    "inventory_reserved": { "type": "number" },
    "sales_velocity": { "type": "number" },
    "current_price": { "type": "number" },
    "economic_floor": { "type": "number" },
    "price_ceiling": { "type": "number" },
    "proposed_price": { "type": "number" },
    "sale_price": { "type": "number" },
    "product_cost": { "type": "number" },
    "referral_fee": { "type": "number" },
    "referral_fee_pct": { "type": "number" },
    "fba_fee": { "type": "number" },
    "fulfillment_cost": { "type": "number" },
    "inbound_freight": { "type": "number" },
    "preparation_cost": { "type": "number" },
    "tax_cost": { "type": "number" },
    "tax_pct": { "type": "number" },
    "coupon_cost": { "type": "number" },
    "discount_cost": { "type": "number" },
    "return_provision": { "type": "number" },
    "other_variable_cost": { "type": "number" },
    "featured_offer_price": { "type": "number" },
    "featured_offer_seller_id": { "type": "string" },
    "featured_offer_expected_price": { "type": "number" },
    "lowest_competitor_price": { "type": "number" },
    "competitive_price": { "type": "number" },
    "was_price": { "type": "number" },
    "stock_qty": { "type": "number", "default": 0 },
    "stock_coverage_days": { "type": "number" },
    "ad_spend": { "type": "number", "default": 0 },
    "ad_sales": { "type": "number", "default": 0 },
    "ad_orders": { "type": "number", "default": 0 },
    "impressions_1d": { "type": "number", "default": 0 },
    "impressions_7d": { "type": "number", "default": 0 },
    "impressions_14d": { "type": "number", "default": 0 },
    "impressions_30d": { "type": "number", "default": 0 },
    "clicks_1d": { "type": "number", "default": 0 },
    "clicks_7d": { "type": "number", "default": 0 },
    "clicks_14d": { "type": "number", "default": 0 },
    "clicks_30d": { "type": "number", "default": 0 },
    "spend_1d": { "type": "number", "default": 0 },
    "spend_7d": { "type": "number", "default": 0 },
    "spend_14d": { "type": "number", "default": 0 },
    "spend_30d": { "type": "number", "default": 0 },
    "same_sku_orders": { "type": "number", "default": 0 },
    "same_sku_sales": { "type": "number", "default": 0 },
    "halo_orders": { "type": "number", "default": 0 },
    "halo_sales": { "type": "number", "default": 0 },
    "total_attributed_orders": { "type": "number", "default": 0 },
    "total_attributed_sales": { "type": "number", "default": 0 },
    "cpc": { "type": "number" },
    "ctr": { "type": "number" },
    "cvr": { "type": "number" },
    "roas": { "type": "number" },
    "tacos": { "type": "number" },
    "current_acos": { "type": "number" },
    "target_acos": { "type": "number" },
    "projected_acos": { "type": "number" },
    "projected_profit_per_unit": { "type": "number" },
    "margin_before_ads": { "type": "number" },
    "margin_rate": { "type": "number" },
    "break_even_acos": { "type": "number" },
    "allowable_ad_spend_per_order": { "type": "number" },
    "maximum_profitable_cpa": { "type": "number" },
    "maximum_economic_cpc": { "type": "number" },
    "safe_max_cpc": { "type": "number" },
    "profit_after_ads": { "type": "number" },
    "profit_per_order": { "type": "number" },
    "profit_per_click": { "type": "number" },
    "contribution_margin": { "type": "number" },
    "economic_confidence": { "type": "number" },
    "predicted_sales_1d": { "type": "number" },
    "predicted_sales_3d": { "type": "number" },
    "predicted_sales_7d": { "type": "number" },
    "predicted_sales_14d": { "type": "number" },
    "sales_forecast_low": { "type": "number" },
    "sales_forecast_median": { "type": "number" },
    "sales_forecast_high": { "type": "number" },
    "forecast_status": { "type": "string" },
    "forecast_confidence": { "type": "number" },
    "price_elasticity": { "type": "number" },
    "elasticity_status": { "type": "string" },
    "elasticity_confidence": { "type": "number" },
    "predicted_conversion_rate": { "type": "number" },
    "predicted_conversion_rate_low": { "type": "number" },
    "predicted_conversion_rate_high": { "type": "number" },
    "cvr_posterior_alpha": { "type": "number" },
    "cvr_posterior_beta": { "type": "number" },
    "probability_cvr_above_threshold": { "type": "number" },
    "predicted_acos": { "type": "number" },
    "predicted_profit": { "type": "number" },
    "probability_of_sale": { "type": "number" },
    "probability_of_profitable_sale": { "type": "number" },
    "probability_of_stockout": { "type": "number" },
    "probability_of_loss": { "type": "number" },
    "prediction_confidence": { "type": "number" },
    "model_version": { "type": "string" },
    "profit_curve": { "type": "string" },
    "product_state": { "type": "string" },
    "campaign_state": { "type": "string" },
    "economic_state": { "type": "string" },
    "risk_state": { "type": "string" },
    "opportunity_state": { "type": "string" },
    "winner_protected": { "type": "boolean", "default": false },
    "low_volume_guarded": { "type": "boolean", "default": false },
    "growth_allowed": { "type": "boolean", "default": false },
    "repricing_allowed": { "type": "boolean", "default": false },
    "bid_increase_allowed": { "type": "boolean", "default": false },
    "bid_reduction_allowed": { "type": "boolean", "default": false },
    "pause_allowed": { "type": "boolean", "default": false },
    "budget_increase_allowed": { "type": "boolean", "default": false },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "action": { "type": "string", "enum": ["increase", "decrease", "hold", "blocked"] },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "validation_preview_status": { "type": "string", "enum": ["not_required", "accepted", "rejected"] },
    "validation_preview_response": { "type": "string" },
    "data_fresh": { "type": "boolean", "default": false },
    "source": { "type": "string", "default": "amazon_sp_api" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["amazon_account_id", "sku", "asin", "snapshot_key", "action"]
}
