{
  "name": "RepricingSnapshot",
  "type": "object",
  "properties": {
    "amazon_account_id": { "type": "string" },
    "marketplace_id": { "type": "string" },
    "seller_id": { "type": "string" },
    "product_id": { "type": "string" },
    "sku": { "type": "string" },
    "asin": { "type": "string" },
    "snapshot_key": { "type": "string" },
    "current_price": { "type": "number" },
    "economic_floor": { "type": "number" },
    "price_ceiling": { "type": "number" },
    "proposed_price": { "type": "number" },
    "featured_offer_price": { "type": "number" },
    "featured_offer_seller_id": { "type": "string" },
    "featured_offer_expected_price": { "type": "number" },
    "lowest_competitor_price": { "type": "number" },
    "competitive_price": { "type": "number" },
    "was_price": { "type": "number" },
    "stock_qty": { "type": "number", "default": 0 },
    "stock_coverage_days": { "type": "number" },
    "ad_spend": { "type": "number", "default": 0 },
    "ad_sales": { "type": "number", "default": 0 },
    "ad_orders": { "type": "number", "default": 0 },
    "current_acos": { "type": "number" },
    "target_acos": { "type": "number" },
    "projected_acos": { "type": "number" },
    "projected_profit_per_unit": { "type": "number" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "action": { "type": "string", "enum": ["increase", "decrease", "hold", "blocked"] },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "validation_preview_status": { "type": "string", "enum": ["not_required", "accepted", "rejected"] },
    "validation_preview_response": { "type": "string" },
    "data_fresh": { "type": "boolean", "default": false },
    "source": { "type": "string", "default": "amazon_sp_api" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["amazon_account_id", "sku", "asin", "snapshot_key", "action"]
}
