{
  "name": "HourlySalesPattern",
  "type": "object",
  "properties": {
    "amazon_account_id": {
      "type": "string"
    },
    "asin": {
      "type": "string",
      "description": "ASIN do produto. null = padr\u00e3o da conta (agregado global)"
    },
    "day_of_week": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
      "description": "0=Dom, 6=Sab"
    },
    "hour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23,
      "description": "Hora BRT (0-23)"
    },
    "slot_label": {
      "type": "string",
      "description": "Ex: SEG_14h"
    },
    "orders": {
      "type": "number",
      "default": 0
    },
    "sales": {
      "type": "number",
      "default": 0
    },
    "spend": {
      "type": "number",
      "default": 0
    },
    "clicks": {
      "type": "number",
      "default": 0
    },
    "impressions": {
      "type": "number",
      "default": 0
    },
    "cvr": {
      "type": "number",
      "default": 0,
      "description": "Taxa de convers\u00e3o m\u00e9dia do slot"
    },
    "acos": {
      "type": "number",
      "default": 0
    },
    "roas": {
      "type": "number",
      "default": 0
    },
    "cpc": {
      "type": "number",
      "default": 0
    },
    "aov": {
      "type": "number",
      "default": 0,
      "description": "Ticket m\u00e9dio do slot"
    },
    "occurrences": {
      "type": "number",
      "default": 0,
      "description": "Quantas semanas este slot teve dados"
    },
    "orders_share_pct": {
      "type": "number",
      "default": 0,
      "description": "% das vendas totais do dia que ocorrem neste hor\u00e1rio"
    },
    "peak_score": {
      "type": "number",
      "default": 0,
      "description": "Score de pico 0-100 (combina orders_share + cvr + acos_efficiency)"
    },
    "classification": {
      "type": "string",
      "enum": [
        "PEAK_ELITE",
        "PEAK_STRONG",
        "NORMAL",
        "WEAK",
        "LOSS",
        "INSUFFICIENT_DATA"
      ],
      "default": "INSUFFICIENT_DATA"
    },
    "bid_multiplier": {
      "type": "number",
      "default": 1.0,
      "description": "Multiplicador de lance sugerido para este slot (1.0 = neutro, 1.2 = +20%)"
    },
    "is_peak_hour": {
      "type": "boolean",
      "default": false
    },
    "data_window_days": {
      "type": "number",
      "default": 28
    },
    "last_computed_at": {
      "type": "string",
      "format": "date-time"
    },
    "drive_backup_at": {
      "type": "string",
      "format": "date-time"
    },
    "drive_file_id": {
      "type": "string"
    },
    "asin_peak_hours_json": {
      "type": "string",
      "description": "JSON: array de horas (0-23) identificadas como pico para este ASIN espec\u00edfico. Ex: [22,23,0,1]"
    },
    "asin_low_hours_json": {
      "type": "string",
      "description": "JSON: array de horas (0-23) identificadas como baixa performance para este ASIN. Ex: [10,11,12]"
    },
    "asin_neutral_hours_json": {
      "type": "string",
      "description": "JSON: array de horas (0-23) de performance neutra/m\u00e9dia para este ASIN"
    },
    "asin_data_maturity": {
      "type": "string",
      "enum": [
        "sufficient",
        "insufficient"
      ],
      "default": "insufficient",
      "description": "sufficient = \u226530 dias hist\u00f3rico E \u226520 cliques/faixa. insufficient = continua usando regras gen\u00e9ricas da conta"
    },
    "asin_peak_score_threshold": {
      "type": "number",
      "default": 0,
      "description": "Score m\u00ednimo calculado para classificar hora como pico neste ASIN"
    },
    "asin_profile_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima vez que o perfil hor\u00e1rio por ASIN foi calculado"
    },
    "asin_days_of_data": {
      "type": "number",
      "default": 0,
      "description": "Quantos dias de dados hist\u00f3ricos foram usados no c\u00e1lculo do perfil ASIN"
    },
    "asin_total_clicks": {
      "type": "number",
      "default": 0,
      "description": "Total de cliques acumulados por faixa usados para validar maturidade"
    },
    "asin_peak_diverges_from_account": {
      "type": "boolean",
      "default": false,
      "description": "true quando o pico do ASIN difere >3h do pico m\u00e9dio da conta"
    }
  },
  "required": [
    "amazon_account_id",
    "day_of_week",
    "hour"
  ]
}