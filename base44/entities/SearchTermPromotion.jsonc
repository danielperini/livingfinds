{
  "name": "SearchTermPromotion",
  "type": "object",
  "properties": {
    "amazon_account_id": {
      "type": "string"
    },
    "asin": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "source_campaign_id": {
      "type": "string"
    },
    "source_ad_group_id": {
      "type": "string"
    },
    "source_search_term": {
      "type": "string"
    },
    "normalized_search_term": {
      "type": "string"
    },
    "orders": {
      "type": "number",
      "default": 0
    },
    "same_sku_orders": {
      "type": "number",
      "default": 0
    },
    "same_sku_sales": {
      "type": "number",
      "default": 0
    },
    "halo_orders": {
      "type": "number",
      "default": 0
    },
    "halo_sales": {
      "type": "number",
      "default": 0
    },
    "same_sku_attribution_verified": {
      "type": "boolean",
      "default": false
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "units_sold": {
      "type": "number",
      "default": 0
    },
    "sales": {
      "type": "number",
      "default": 0
    },
    "spend": {
      "type": "number",
      "default": 0
    },
    "clicks": {
      "type": "number",
      "default": 0
    },
    "average_cpc": {
      "type": "number",
      "default": 0
    },
    "acos": {
      "type": "number",
      "default": 0
    },
    "roas": {
      "type": "number",
      "default": 0
    },
    "target_bid": {
      "type": "number",
      "default": 0.5
    },
    "initial_budget": {
      "type": "number",
      "default": 0
    },
    "winner_score": {
      "type": "number",
      "default": 0
    },
    "amazon_confirmation_status": {
      "type": "string",
      "default": "pending"
    },
    "destination_campaign_id": {
      "type": "string"
    },
    "destination_campaign_name": {
      "type": "string"
    },
    "destination_ad_group_id": {
      "type": "string"
    },
    "destination_ad_id": {
      "type": "string"
    },
    "destination_keyword_id": {
      "type": "string"
    },
    "negative_keyword_id": {
      "type": "string"
    },
    "promotion_status": {
      "type": "string",
      "enum": [
        "identified",
        "validated",
        "campaign_creating",
        "campaign_created",
        "ad_group_created",
        "product_ad_created",
        "keyword_created",
        "confirming",
        "confirmed",
        "enabling",
        "manual_active",
        "negative_creating",
        "negative_created",
        "completed",
        "repair_required",
        "failed_retryable",
        "failed_permanent"
      ],
      "default": "identified"
    },
    "completion_status": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "last_error": {
      "type": "string"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "ai_validated": {
      "type": "boolean",
      "default": false
    },
    "ai_relevance_check": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_retry_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_sku": {
      "type": "string"
    },
    "destination_sku": {
      "type": "string"
    },
    "source_asin": {
      "type": "string"
    },
    "source_account_profile_id": {
      "type": "string"
    },
    "destination_account_profile_id": {
      "type": "string"
    },
    "source_marketplace": {
      "type": "string"
    },
    "destination_marketplace": {
      "type": "string"
    },
    "relevance_reason": {
      "type": "string"
    },
    "review_block_reason": {
      "type": "string"
    },
    "source_orders": {
      "type": "number"
    },
    "source_acos": {
      "type": "number"
    },
    "source_roas": {
      "type": "number"
    },
    "source_cpc": {
      "type": "number"
    },
    "heuristic_relevance_score": {
      "type": "number"
    },
    "ai_relevance_score": {
      "type": "number"
    },
    "destination_safe_max_cpc": {
      "type": "number"
    },
    "source_attribution_verified": {
      "type": "boolean",
      "default": false
    },
    "destination_economics_verified": {
      "type": "boolean",
      "default": false
    },
    "destination_stock_verified": {
      "type": "boolean",
      "default": false
    },
    "destination_listing_buyable": {
      "type": "boolean",
      "default": false
    },
    "destination_ads_authorized": {
      "type": "boolean",
      "default": false
    },
    "ai_relevance_validated": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "amazon_account_id",
    "source_campaign_id",
    "asin",
    "source_search_term"
  ]
}
