{
  "name": "V6SIAReviewLog",
  "type": "object",
  "properties": {
    "amazon_account_id": { "type": "string" },
    "profile_id": { "type": "string" },
    "marketplace_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "review_type": { "type": "string", "enum": ["daily_portfolio", "execution_failure"] },
    "trigger_type": { "type": "string" },
    "engine_version": { "type": "string", "default": "V6SIA" },
    "status": { "type": "string", "enum": ["success", "deferred", "error", "partial"] },
    "ai_provider": { "type": "string" },
    "ai_model": { "type": "string" },
    "ai_call_status": { "type": "string", "enum": ["called", "cache_reused", "budget_deferred", "incomplete", "failed"] },
    "ai_request_id": { "type": "string" },
    "ai_finish_reason": { "type": "string" },
    "ai_usage_json": { "type": "string" },
    "ai_tokens": { "type": "number" },
    "ai_input_hash": { "type": "string" },
    "source_tables_json": { "type": "string" },
    "source_refs_json": { "type": "string" },
    "source_counts_json": { "type": "string" },
    "data_window_start": { "type": "string", "format": "date" },
    "data_window_end": { "type": "string", "format": "date" },
    "data_as_of": { "type": "string", "format": "date-time" },
    "data_quality_status": { "type": "string", "enum": ["complete", "partial", "unavailable"] },
    "data_query_errors_json": { "type": "string" },
    "metrics_summary_json": { "type": "string" },
    "decision_ids_json": { "type": "string" },
    "decision_outcomes_json": { "type": "string" },
    "failure_context_json": { "type": "string" },
    "implementation_status": { "type": "string", "enum": ["implemented", "partial", "not_implemented", "pending_confirmation", "not_applicable"] },
    "ai_recommendation_status": { "type": "string", "enum": ["diagnostic_only", "not_generated", "incomplete", "failed"] },
    "findings_json": { "type": "string" },
    "gate_reason": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "number" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["amazon_account_id", "correlation_id", "review_type", "status", "ai_call_status"]
}
