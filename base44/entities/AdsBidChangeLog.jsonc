{
  "name": "AdsBidChangeLog",
  "type": "object",
  "properties": {
    "amazon_account_id": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "execution_run_id": { "type": "string" },
    "campaign_id": { "type": "string" },
    "campaign_name": { "type": "string" },
    "ad_group_id": { "type": "string" },
    "entity_type": {
      "type": "string",
      "enum": ["keyword", "ad_group", "product_target", "campaign"]
    },
    "entity_id": { "type": "string" },
    "keyword_id": { "type": "string" },
    "keyword": { "type": "string" },
    "keyword_text": { "type": "string" },
    "target_id": { "type": "string" },
    "asin": { "type": "string" },
    "old_bid": { "type": "number" },
    "new_bid": { "type": "number" },
    "bid_before": { "type": "number" },
    "bid_after": { "type": "number" },
    "change_amount": { "type": "number" },
    "change_percent": { "type": "number" },
    "change_pct": { "type": "number" },
    "direction": {
      "type": "string",
      "enum": ["increase", "decrease", "unchanged", "restore"]
    },
    "action": { "type": "string" },
    "reason": { "type": "string" },
    "evidence": { "type": "string" },
    "classification": { "type": "string" },
    "account_daily_spend": { "type": "number" },
    "remaining_account_budget": { "type": "number" },
    "campaign_virtual_budget": { "type": "number" },
    "campaign_spend_share": { "type": "number" },
    "campaign_target_share": { "type": "number" },
    "spend_share_deviation": { "type": "number" },
    "impressions": { "type": "number" },
    "clicks": { "type": "number" },
    "orders": { "type": "number" },
    "sales": { "type": "number" },
    "spend": { "type": "number" },
    "cpc": { "type": "number" },
    "acos": { "type": "number" },
    "profit_after_ads": { "type": "number" },
    "margin_percent": { "type": "number" },
    "maximum_economic_cpc": { "type": "number" },
    "max_spend_without_sale": { "type": "number" },
    "stock_qty": { "type": "number" },
    "stock_coverage_days": { "type": "number" },
    "next_evaluation_at": { "type": "string", "format": "date-time" },
    "block_name": { "type": "string" },
    "stop_type": { "type": "string" },
    "source": { "type": "string" },
    "ai_confidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "status": {
      "type": "string",
      "enum": ["pending", "executed", "failed", "skipped"],
      "default": "pending"
    },
    "amazon_response": { "type": "string" },
    "decision_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["amazon_account_id"]
}
