{
  "name": "NegativeKeywordSuggestion",
  "type": "object",
  "properties": {
    "amazon_account_id": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "campaign_name": {
      "type": "string"
    },
    "ad_group_id": {
      "type": "string"
    },
    "keyword_text": {
      "type": "string"
    },
    "match_type": {
      "type": "string"
    },
    "clicks": {
      "type": "number"
    },
    "orders": { "type": "number" },
    "spend": {
      "type": "number"
    },
    "sales": {
      "type": "number"
    },
    "acos": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "applied",
        "sent"
      ],
      "default": "pending"
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_status": {
      "type": "string",
      "enum": ["not_started", "sending", "sent", "confirmed", "failed"]
    },
    "execution_error": { "type": "string" },
    "agent_action_id": { "type": "string" },
    "amazon_request_id": { "type": "string" }
  },
  "required": [
    "amazon_account_id",
    "keyword_text"
  ]
}