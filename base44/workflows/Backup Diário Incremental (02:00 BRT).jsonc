{
  "name": "Backup Di\u00e1rio Incremental (02:00 BRT)",
  "description": "Backup incremental di\u00e1rio \u00e0s 02:00 BRT (05:00 UTC) \u2014 apenas registros criados/atualizados desde ontem",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 5 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "backup_di_rio_incremental_02_00_brt",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runBackupToDrive",
            "args": {
              "backup_type": "daily_incremental",
              "_service_role": true
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "runBackupToDrive"
  }
}