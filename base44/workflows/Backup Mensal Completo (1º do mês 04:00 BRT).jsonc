{
  "name": "Backup Mensal Completo (1\u00ba do m\u00eas 04:00 BRT)",
  "description": "Backup completo mensal no primeiro dia de cada m\u00eas \u00e0s 04:00 BRT (07:00 UTC)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 1 * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "backup_mensal_completo_1_do_m_s_04_00_brt",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runBackupToDrive",
            "args": {
              "backup_type": "monthly_full",
              "_service_role": true
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "runBackupToDrive"
  }
}