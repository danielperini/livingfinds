{
  "name": "Campaign State Divergence Auto-Repair",
  "description": "Roda diariamente \u00e0s 03:00 BRT. Detecta campanhas com state=paused no banco mas amazon_status=enabled na Amazon e for\u00e7a a pausa na API.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "campaign_state_divergence_auto_repair",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "forcePauseCampaignsByAsin",
            "args": {
              "_service_role": true
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "forcePauseCampaignsByAsin"
  }
}