{
  "name": "Backup Listing no Drive ap\u00f3s publica\u00e7\u00e3o",
  "description": "Salva snapshot + proposals + hist\u00f3rico do ASIN no Drive sempre que uma altera\u00e7\u00e3o \u00e9 publicada, organizado por ASIN e timestamp BRT.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ListingEnhancementHistory"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "backup_listing_no_drive_ap_s_publica_o",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "backupListingToDrive",
            "args": {
              "backup_type": "daily_incremental"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "backupListingToDrive"
  }
}