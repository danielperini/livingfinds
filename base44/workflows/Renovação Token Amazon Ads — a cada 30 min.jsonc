{
  "name": "Renova\u00e7\u00e3o Token Amazon Ads \u2014 a cada 30 min",
  "description": "Renova proativamente o access_token Amazon Ads a cada 40 minutos, 24h/dia. force_refresh=true garante renova\u00e7\u00e3o independente do status da conta. S\u00f3 solicita reautentica\u00e7\u00e3o ao usu\u00e1rio em caso de invalid_grant ou credenciais inv\u00e1lidas (ADS_CLIENT_ID/ADS_CLIENT_SECRET). Erros 429, 500, 504, 524 e timeouts aguardam o pr\u00f3ximo ciclo automaticamente.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 30,
      "interval_unit": "minutes",
      "interval_anchor": "2026-07-10T14:09:26.237000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "renova_o_token_amazon_ads_a_cada_30_min",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "refreshAmazonAdsTokenDailyOrHourly",
            "args": {
              "_service_role": true,
              "force_refresh": true
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "refreshAmazonAdsTokenDailyOrHourly"
  }
}