{
  "name": "Budget Pacing \u2014 Checkpoint Manh\u00e3 07:00 BRT",
  "description": "Checkpoint matinal: l\u00ea gasto real, projeta EOD, recalibra CPC e dayparting se overpacing ou underpacing. Executa \u00e0s 07:00 BRT (10:00 UTC).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 10 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "budget_pacing_checkpoint_manh_07_00_brt",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runIntraDayBudgetPacingCycle",
            "args": {
              "checkpoint": "morning",
              "_service_role": true
            }
