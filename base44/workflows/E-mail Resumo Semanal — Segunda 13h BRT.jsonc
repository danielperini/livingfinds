{
  "name": "E-mail Resumo Semanal \u2014 Segunda 13h BRT",
  "description": "Envia e-mail HTML de resumo semanal para contato@livingfinds.com.br toda segunda-feira \u00e0s 13h BRT (16h UTC) com KPIs da semana: gasto, faturamento real, ACoS, ROAS, TACoS, pedidos e decis\u00f5es executadas pelo motor.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 16 * * 1",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "e_mail_resumo_semanal_segunda_13h_brt",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendWeeklyAdsSummaryEmail",
            "args": {
              "_service_role": true
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendWeeklyAdsSummaryEmail"
  }
}