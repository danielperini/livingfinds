{
  "name": "Varredura de Campanhas Incompletas \u2014 a cada 12h",
  "description": "Varre todas as campanhas com status 'incomplete' no banco e as enfileira automaticamente na AutoCampaignRepairQueue para reparo. Roda a cada 12h (06:00 e 18:00 UTC = 03:00 e 15:00 BRT).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "varredura_de_campanhas_incompletas_a_cada_12h",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scanAndQueueIncompleteCampaigns",
            "args": {
              "_service_role": true
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "scanAndQueueIncompleteCampaigns"
  }
}