{
  "name": "Auto-Fix Sync Failures",
  "description": "Monitora falhas de sincroniza\u00e7\u00e3o e corrige automaticamente: libera locks travados, renova tokens expirados, re-tenta syncs com erro de DB e re-solicita relat\u00f3rios com problema.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 6,
      "interval_unit": "hours",
      "interval_anchor": "2026-07-09T14:27:57.618000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_fix_sync_failures",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoFixSyncFailures",
            "args": {
              "_service_role": true,
              "trigger_type": "scheduled"
            }
          },
          "then": "end"
