{
  "name": "Email Relat\u00f3rio Prele\u00e7\u00e3o Semanal",
  "description": "Envia email autom\u00e1tico com relat\u00f3rio comparando ACoS, ROAS, CPC e budget reais vs metas configuradas, incluindo % de efetividade do motor di\u00e1rio.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"completed\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "WeeklyMotorPrelection"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "email_relat_rio_prele_o_semanal",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendPrelectionReportEmail",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendPrelectionReportEmail"
  }
}