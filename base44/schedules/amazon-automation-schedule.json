{
  "timezone": "America/Sao_Paulo",
  "jobs": [
    {
      "name": "Amazon Action Queue - 16:00 BRT",
      "function": "processAmazonNightWindow",
      "cron": "0 16 * * *",
      "payload": { "_service_role": true, "hour": 16 }
    },
    {
      "name": "Amazon Action Queue - 17:00 BRT",
      "function": "processAmazonNightWindow",
      "cron": "0 17 * * *",
      "payload": { "_service_role": true, "hour": 17 }
    },
    {
      "name": "Amazon Recovery - 06:00 BRT",
      "function": "runMorningRecovery0600",
      "cron": "0 6 * * *",
      "payload": { "_service_role": true, "force": true }
    },
    {
      "name": "Budget Checkpoint 06h BRT",
      "function": "runIntraDayBudgetPacingCycle",
      "cron": "5 6 * * *",
      "payload": { "_service_role": true, "checkpoint": "morning", "hour": 6 }
    },
    {
      "name": "Auto Stock Guard - 07:00 BRT",
      "function": "autoStockCampaignGuard",
      "cron": "0 7 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Amazon Reports Audit ML - 06:40 BRT",
      "function": "runMorningAmazonSchedule",
      "cron": "40 6 * * *",
      "payload": { "_service_role": true, "force": true }
    },
    {
      "name": "Budget Checkpoint 13h BRT",
      "function": "runIntraDayBudgetPacingCycle",
      "cron": "5 13 * * *",
      "payload": { "_service_role": true, "checkpoint": "afternoon", "hour": 13 }
    },
    {
      "name": "Budget Checkpoint 19h BRT",
      "function": "runIntraDayBudgetPacingCycle",
      "cron": "0 19 * * *",
      "payload": { "_service_role": true, "checkpoint": "evening", "hour": 19 }
    },
    {
      "name": "Budget Checkpoint 22h BRT",
      "function": "runIntraDayBudgetPacingCycle",
      "cron": "0 22 * * *",
      "payload": { "_service_role": true, "checkpoint": "night", "hour": 22 }
    }
  ]
}
