{
  "timezone": "America/Sao_Paulo",
  "jobs": [
    {
      "name": "Amazon Ads Reports Poll + Daily AI - every 10 minutes",
      "function": "pollAmazonAdsReportJobs",
      "cron": "*/10 * * * *",
      "payload": { "_service_role": true, "max_jobs": 10 }
    },
    {
      "name": "Request closed-day Amazon Ads reports - 00:01 BRT",
      "function": "ensureDailyReportsCurrent",
      "cron": "1 0 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "SKU Profit Protection + Daily Order Cap - every 15 minutes",
      "function": "enforceSkuProfitProtection",
      "cron": "*/15 * * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Manual zero-click delivery diagnosis and safe bid rescue - every 3 hours",
      "function": "runManualZeroDeliveryBootstrap",
      "cron": "8 */3 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Daily report freshness self-heal - hourly",
      "function": "ensureDailyReportsCurrent",
      "cron": "5 7-23 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Daily Budget Pacing Plan - 00:05 BRT",
      "function": "runDailyBudgetPacingEngine",
      "cron": "5 0 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Amazon Intraday Metrics Pipeline",
      "function": "syncAmazonIntradayCampaignMetrics",
      "cron": "2,17,32,47 * * * *",
      "payload": { "_service_role": true, "action": "auto", "trigger_type": "scheduler_intraday" }
    },
    {
      "name": "Motor v8 complete hourly pipeline",
      "function": "runMotorImediato",
      "cron": "25 * * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Confirm canonical Amazon decisions - every 10 minutes",
      "function": "confirmExecutedDecisions",
      "cron": "7,17,27,37,47,57 * * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Amazon offer availability verification - every 10 minutes",
      "function": "syncAmazonOfferAvailability",
      "cron": "1,11,21,31,41,51 * * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Persistent Product Campaign Pause Guard - every 10 minutes",
      "function": "autoStockCampaignGuard",
      "cron": "3,13,23,33,43,53 * * * *",
      "payload": { "_service_role": true, "enforce_pause_locks": true }
    },
    {
      "name": "Zero-sales reactivation monitor - every 3 hours",
      "function": "monitorZeroSalesReactivation",
      "cron": "42 */3 * * *",
      "payload": { "_service_role": true }
    },
    {
