      "function": "runWeeklyAdsPerformanceReport",
      "cron": "20 8 * * *",
      "payload": { "_service_role": true, "force": true }
    },
    {
      "name": "SP-API Finance Events freshness self-heal - 13:20 and 20:20 BRT",
      "function": "syncFinanceEventsFromSpApi",
      "cron": "20 13,20 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Amazon Action Queue - 13:00 BRT",
      "function": "processAmazonNightWindow",
      "cron": "0 13 * * *",
      "payload": { "_service_role": true, "hour": 13 }
    },
    {
      "name": "Pacing full checkpoints - 06, 13, 19 and 22 BRT",
      "function": "runIntraDayPacingCycle",
      "cron": "0 6,13,19,22 * * *",
      "payload": { "_service_role": true, "checkpoint": true, "source_function": "scheduler_full_checkpoint" }
    },
    {
      "name": "Final daily reports reconciliation - 23:45 BRT",
      "function": "dailyReportReconciliation",
      "cron": "45 23 * * *",
      "payload": { "_service_role": true }
    }
  ]
}
