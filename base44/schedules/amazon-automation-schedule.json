{
  "timezone": "America/Sao_Paulo",
  "jobs": [
    {
      "name": "Amazon Ads Reports Poll + Daily AI - every 10 minutes",
      "function": "pollAmazonAdsReportJobs",
      "cron": "*/10 * * * *",
      "payload": { "_service_role": true, "max_jobs": 10 }
    },
    {
      "name": "Request closed-day Amazon Ads reports - 00:01 BRT",
      "function": "ensureDailyReportsCurrent",
      "cron": "1 0 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "SKU Profit Protection + Daily Order Cap - every 15 minutes",
      "function": "enforceSkuProfitProtection",
      "cron": "*/15 * * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Manual zero-click delivery diagnosis and safe bid rescue - every 3 hours",
      "function": "runManualZeroDeliveryBootstrap",
      "cron": "8 */3 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Daily report freshness self-heal - hourly",
      "function": "ensureDailyReportsCurrent",
      "cron": "5 7-23 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Daily Budget Pacing Plan - 00:05 BRT",
      "function": "runDailyBudgetPacingEngine",
      "cron": "5 0 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Amazon Intraday Metrics Pipeline",
      "function": "syncAmazonIntradayCampaignMetrics",
      "cron": "2,17,32,47 * * * *",
      "payload": { "_service_role": true, "action": "auto", "trigger_type": "scheduler_intraday" }
    },
    {
      "name": "Portfolio Daily Budget Pacing",
      "function": "runIntraDayPacingCycle",
      "cron": "10,40 6-23 * * *",
      "payload": { "_service_role": true, "source_function": "scheduler_portfolio_pacing" }
    },
    {
      "name": "Amazon Action Queue - 00:00 BRT",
      "function": "processAmazonNightWindow",
      "cron": "0 0 * * *",
      "payload": { "_service_role": true, "hour": 0 }
    },
    {
      "name": "Amazon Action Queue - 01:00 BRT",
      "function": "processAmazonNightWindow",
      "cron": "0 1 * * *",
      "payload": { "_service_role": true, "hour": 1 }
    },
    {
      "name": "Amazon Action Queue - 02:00 BRT",
      "function": "processAmazonNightWindow",
      "cron": "0 2 * * *",
      "payload": { "_service_role": true, "hour": 2 }
    },
    {
      "name": "Amazon Action Queue - 03:00 BRT",
      "function": "processAmazonNightWindow",
      "cron": "0 3 * * *",
      "payload": { "_service_role": true, "hour": 3 }
    },
    {
      "name": "Amazon Recovery - 06:00 BRT",
      "function": "runMorningRecovery0600",
      "cron": "0 6 * * *",
      "payload": { "_service_role": true, "force": true }
    },
    {
      "name": "Auto Stock Guard - 07:00 BRT",
      "function": "autoStockCampaignGuard",
      "cron": "0 7 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Amazon Reports Audit ML - 06:40 BRT",
      "function": "runMorningAmazonSchedule",
      "cron": "40 6 * * *",
      "payload": { "_service_role": true, "force": true }
    },
    {
      "name": "Daily Economic Assessment - 08:00 BRT",
      "function": "runDailyEconomicAssessment",
      "cron": "0 8 * * *",
      "payload": { "_service_role": true, "force": true }
    },
    {
      "name": "Rolling Weekly Ads and Economics Report - 08:20 BRT",
      "function": "runWeeklyAdsPerformanceReport",
      "cron": "20 8 * * *",
      "payload": { "_service_role": true, "force": true }
    },
    {
      "name": "SP-API Finance Events freshness self-heal - 13:20 and 20:20 BRT",
      "function": "syncFinanceEventsFromSpApi",
      "cron": "20 13,20 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Amazon Action Queue - 13:00 BRT",
      "function": "processAmazonNightWindow",
      "cron": "0 13 * * *",
      "payload": { "_service_role": true, "hour": 13 }
    },
    {
      "name": "Pacing full checkpoints - 06, 13, 19 and 22 BRT",
      "function": "runIntraDayPacingCycle",
      "cron": "0 6,13,19,22 * * *",
      "payload": { "_service_role": true, "checkpoint": true, "source_function": "scheduler_full_checkpoint" }
    },
    {
      "name": "Final daily reports reconciliation - 23:45 BRT",
      "function": "dailyReportReconciliation",
      "cron": "45 23 * * *",
      "payload": { "_service_role": true }
    }
  ]
}
