{
  "timezone": "America/Sao_Paulo",
  "jobs": [
    {
      "name": "Amazon Ads report polling - every 10 minutes",
      "function": "pollAmazonAdsReportJobs",
      "cron": "*/10 * * * *",
      "payload": { "_service_role": true, "max_jobs": 10 }
    },
    {
      "name": "Amazon intraday campaign metrics - every 15 minutes",
      "function": "syncAmazonIntradayCampaignMetrics",
      "cron": "2,17,32,47 * * * *",
      "payload": { "_service_role": true, "action": "auto", "trigger_type": "scheduler_intraday" }
    },
    {
      "name": "Amazon campaign state reconciliation - every 15 minutes",
      "function": "syncAdsCampaignStatesV2",
      "cron": "1,16,31,46 * * * *",
      "payload": { "_service_role": true, "trigger_type": "scheduler_intraday_state" }
    },
    {
      "name": "Amazon offer and buyability verification - every 10 minutes",
      "function": "syncAmazonOfferAvailability",
      "cron": "1,11,21,31,41,51 * * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Closed-day Amazon reports request - 00:01 BRT",
      "function": "ensureDailyReportsCurrent",
      "cron": "1 0 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Unified marketplace decision engine - every 15 minutes",
      "function": "runUnifiedDecisionEngine",
      "cron": "4,19,34,49 * * * *",
      "payload": { "_service_role": true, "dry_run": false, "skip_sync": true, "trigger_type": "scheduler_intraday" }
    },
    {
      "name": "Unified daily close, bootstrap-aware audit and repricing - 01:25 BRT",
      "function": "runUnifiedDecisionEngine",
      "cron": "25 1 * * *",
      "payload": { "_service_role": true, "dry_run": false, "daily_close": true, "full_repricing_evaluation": true, "trigger_type": "scheduler_daily_close" }
    },
    {
      "name": "Canonical decision executor - every 15 minutes",
      "function": "executeApprovedDecisionQueue",
      "cron": "6,21,36,51 * * * *",
      "payload": { "_service_role": true, "max_decisions": 25 }
    },
    {
      "name": "Canonical Amazon decision confirmation - every 15 minutes",
      "function": "confirmExecutedDecisions",
      "cron": "9,24,39,54 * * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Canonical dayparting - hourly after intraday metrics",
      "function": "runCanonicalDaypartingEngine",
      "cron": "12 * * * *",
      "payload": { "_service_role": true, "dry_run": false, "trigger_type": "scheduler_hourly_dayparting" }
    },
    {
      "name": "Zyte real competitor research - every 6 hours",
      "function": "refreshZyteCompetitorResearch",
      "cron": "18 1,7,13,19 * * *",
      "payload": { "_service_role": true, "max_products": 20 },
      "run_on_startup": true
    },
    {
      "name": "Repricing transport queue - every 5 minutes",
      "function": "runAutomaticRepricing",
      "cron": "*/5 * * * *",
      "payload": { "_service_role": true, "operation": "process_queue", "max_actions": 20, "transport_only": true }
    },
    {
      "name": "Repricing transport reconciliation - 04:43 BRT",
      "function": "runAutomaticRepricing",
      "cron": "43 4 * * *",
      "payload": { "_service_role": true, "operation": "reconcile", "max_actions": 100, "transport_only": true }
    },
    {
      "name": "Finance events freshness - 05:50 BRT",
      "function": "syncFinanceEventsFromSpApi",
      "cron": "50 5 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Finance events refresh - 13:20 and 20:20 BRT",
      "function": "syncFinanceEventsFromSpApi",
      "cron": "20 13,20 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Daily decision outcome monitor - 03:30 BRT",
      "function": "monitorRulePerformance",
      "cron": "30 3 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Weekly deterministic rule review - Sunday 03:00 BRT",
      "function": "runWeeklyClaudeRuleReview",
      "cron": "0 3 * * 0",
      "payload": { "_service_role": true }
    }
  ]
}
