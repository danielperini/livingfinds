      "function": "runCampaignPortfolioGrowthCycle",
      "cron": "45 4 * * *",
      "payload": { "_service_role": true, "full_expansion": false }
    },
    {
      "name": "AUTO winners, Keyword Bank and guarded expansion - weekly",
      "function": "runCampaignPortfolioGrowthCycle",
      "cron": "15 6 * * 1",
      "payload": { "_service_role": true, "full_expansion": true }
    },
    {
      "name": "Hourly Metrics Bridge and Dayparting Patterns",
      "function": "rebuildHourlyMetricsFromReports",
      "cron": "55 * * * *",
      "payload": { "_service_role": true, "lookback_days": 3 }
    },
    {
      "name": "Portfolio Daily Budget Pacing",
      "function": "runIntraDayPacingCycle",
      "cron": "10,40 6-23 * * *",
      "payload": { "_service_role": true, "source_function": "scheduler_portfolio_pacing" }
    },
    {
      "name": "Amazon Action Queue - 00:00 BRT",
      "function": "processAmazonNightWindow",
      "cron": "0 0 * * *",
      "payload": { "_service_role": true, "hour": 0 }
    },
    {
      "name": "Amazon Action Queue - 01:00 BRT",
      "function": "processAmazonNightWindow",
      "cron": "0 1 * * *",
      "payload": { "_service_role": true, "hour": 1 }
    },
    {
      "name": "Amazon Action Queue - 02:00 BRT",
      "function": "processAmazonNightWindow",
      "cron": "0 2 * * *",
      "payload": { "_service_role": true, "hour": 2 }
    },
    {
      "name": "Amazon Action Queue - 03:00 BRT",
      "function": "processAmazonNightWindow",
      "cron": "0 3 * * *",
      "payload": { "_service_role": true, "hour": 3 }
    },
    {
      "name": "Amazon Recovery - 06:00 BRT",
      "function": "runMorningRecovery0600",
      "cron": "0 6 * * *",
      "payload": { "_service_role": true, "force": true }
    },
    {
      "name": "Auto Stock Guard - 07:00 BRT",
      "function": "autoStockCampaignGuard",
      "cron": "0 7 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Amazon Reports Audit ML - 06:40 BRT",
      "function": "runMorningAmazonSchedule",
      "cron": "40 6 * * *",
      "payload": { "_service_role": true, "force": true }
    },
    {
      "name": "AUTO search-term harvest into Term Bank - 07:15 BRT",
      "function": "updateTermBankFromAutomaticCampaigns",
      "cron": "15 7 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Campaign Factory retrospective learning - 07:30 BRT",
      "function": "runCampaignFactory",
      "cron": "30 7 * * *",
      "payload": { "_service_role": true }
    },
    {
      "name": "Amazon Ads hourly history - 05:15 BRT",
      "function": "syncUnifiedAdsReportsHourly",
      "cron": "15 5 * * *",
      "payload": { "_service_role": true, "days": 14, "force": true }
    },
    {
      "name": "Full hourly rebuild after Amazon report - 05:35 BRT",
      "function": "rebuildHourlyMetricsFromReports",
      "cron": "35 5 * * *",
      "payload": { "_service_role": true, "full": true, "lookback_days": 30 }
    },
    {
      "name": "Daily Economic Assessment - 08:00 BRT",
      "function": "runDailyEconomicAssessment",
      "cron": "0 8 * * *",
      "payload": { "_service_role": true, "force": true }
